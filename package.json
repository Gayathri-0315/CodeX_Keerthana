{
  "name": "showup",
  "private": true,
  "description": "Events that fit your week. ShowUp helps you show up.",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/py.mjs --watch app -m uvicorn app.main:app --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "seed": "node scripts/py.mjs -m app.seed.seed",
    "test": "node scripts/py.mjs -m pytest -q",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
