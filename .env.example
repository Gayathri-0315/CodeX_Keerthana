# Copy to .env for local development. Never commit .env.
APP_ENV=dev                      # dev | production (production refuses SQLite and weak secrets)
JWT_SECRET=change-me             # production: a random string of 32+ characters
DATABASE_URL=sqlite:///./showup.db   # production: your PostgreSQL URL (postgres://... works)
PUBLIC_URL=http://localhost:5173 # where links in emails and invites point
FRONTEND_ORIGIN=http://localhost:5173

# Email over HTTPS. Leave EMAIL_API_KEY empty to print emails to the server log instead ("email skipped").
EMAIL_PROVIDER=                  # resend | brevo
EMAIL_API_KEY=
EMAIL_FROM=                      # e.g. ShowUp <hello@your-domain.com> (a sender verified with the provider)

# AI (optional). Without a key, poster and timetable reading fall back to the manual form.
AI_MODE=auto                     # auto | mock | live
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Groq (optional): AI chat safety check, natural-language search, event Q&A, writing help.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
SEARCH_MODEL=                    # optional; defaults to GROQ_MODEL

ORS_API_KEY=
WAITLIST_CONFIRM_MINUTES=15

# Local development only: password for the sample accounts made by `npm run seed`.
SEED_DEV_PASSWORD=

# Frontend build (optional): contact address shown in the footer and legal pages.
VITE_CONTACT_EMAIL=
